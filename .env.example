# Discord Configuration (Kullanıcı Tokeni veya Bot Tokeni)
DISCORD_TOKEN=
DISCORD_GUILD_ID=0
DISCORD_CHANNEL_ID=0

# Gamblit Account Configuration
GAMBLIT_BASE_URL=https://gamblit.net
GAMBLIT_COOKIES=
GAMBLIT_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/124.0.0.0 Safari/537.36

# Captcha Solvers (Otomatik Çözücüler - İsteğe Bağlı)
CAPSOLVER_API_KEY=
TWOCAPTCHA_API_KEY=

# Redeeming & Network Optimization
REDEEM_ENDPOINTS=/api/promo/redeem,/api/codes/redeem,/api/promocode/redeem,/api/user/redeem
CONNECT_TIMEOUT_SEC=3.0
READ_TIMEOUT_SEC=5.0
MAX_RETRIES=2
RATE_LIMIT_BACKOFF_FACTOR=1.5
PORT=5050

# Worker & Database
DATABASE_PATH=data/gamblit.db
LOG_LEVEL=INFO
LOG_FILE=logs/app.log
